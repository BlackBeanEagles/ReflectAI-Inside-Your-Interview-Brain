# Copy this to .env for local development. Never commit the real .env file
# (it's already in .gitignore). On a hosted platform, set these as
# environment variables / secrets in that platform's dashboard instead.

# ── LLM backend ───────────────────────────────────────────────────────────────
# "ollama" (default) — local model, needs a GPU/enough RAM, good for dev only.
# "groq"   — free hosted inference, no GPU needed, what production should use.
LLM_PROVIDER=ollama

# Only used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=2048

# Only used when LLM_PROVIDER=groq — get a free key at https://console.groq.com
# Also required for voice input (speech-to-text) regardless of LLM_PROVIDER —
# transcription always goes through Groq's Whisper API (see services/speech.py).
# Without this set, voice input is unavailable and users fall back to typing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Max size (MB) for a recorded voice answer upload before it's rejected.
MAX_AUDIO_MB=10

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API.
# Add your hosted Streamlit app's URL here once you have one, e.g.
# ALLOWED_ORIGINS=http://localhost:8501,https://your-app.streamlit.app
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# Optional: regex for platforms with per-deploy subdomains.
# ALLOWED_ORIGIN_REGEX=^https://.*\.streamlit\.app$

# ── Rate limiting (protects a public deployment from abuse) ──────────────────
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX_REQUESTS=20

# ── Upload / input limits ─────────────────────────────────────────────────────
MAX_UPLOAD_MB=5
MAX_PASTE_CHARS=20000

# ── Session storage (in-memory; see services/session_manager.py) ─────────────
SESSION_TTL_MINUTES=180
MAX_SESSIONS=500

# ── Persistent storage (optional; see services/db.py) ─────────────────────────
# Postgres connection string. Free tier: https://neon.tech — create a project,
# copy the connection string it gives you. Leave blank to run with in-memory
# storage only (resumes/answers are lost on restart, same as before this was
# added). When set, every uploaded resume and evaluated answer is saved
# permanently, tied to a session_id — see PRIVACY.md before enabling this on
# a deployment real users will use.
DATABASE_URL=
# How long (seconds) a single DB operation may block before giving up and
# skipping persistence for that request. Keeps a slow/sleeping DB from
# stalling the user-facing request it's attached to.
DB_CONNECT_TIMEOUT_S=3

# ── User accounts (optional; see services/auth.py) ────────────────────────────
# Accounts require DATABASE_URL above to be set — there's no meaningful way to
# have a durable account backed only by in-memory state. Without DATABASE_URL,
# /auth/* endpoints return a clear 503 and the rest of the app is unaffected;
# anonymous use (no login) always works regardless of this section.
#
# Secret used to sign login tokens (JWTs). If left blank, a random secret is
# generated each time the process starts — logins still work, but every user
# gets logged out on the next restart/redeploy. Set this explicitly in
# production so restarts don't silently sign everyone out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# How long a login token stays valid, in hours. 168 = 7 days.
JWT_EXPIRY_HOURS=168

# ── Frontend (frontend/app.py) ────────────────────────────────────────────────
# Only needed when the frontend and backend are hosted separately.
BACKEND_BASE=http://127.0.0.1:8000
