# Base URL of the FastAPI backend. Must be publicly reachable from the
# browser (this is a client-side env var -- NEXT_PUBLIC_ prefix required).
NEXT_PUBLIC_API_BASE=https://reflectinterview-api.onrender.com

# Canonical public URL of THIS frontend. Used for metadataBase, which is what
# lets Next resolve the generated Open Graph image to an absolute URL --
# without it link previews ship a relative path that every scraper ignores.
# Optional: defaults to the production Vercel domain.
NEXT_PUBLIC_SITE_URL=https://reflect-ai-inside-your-interview-br.vercel.app
